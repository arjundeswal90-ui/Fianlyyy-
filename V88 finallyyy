local function getTargetPlayer(nameText)
	nameText = nameText:lower():gsub("%s+", "")
	for _, p in pairs(Players:GetPlayers()) do
		if p.Name:lower():sub(1, #nameText) == nameText or p.DisplayName:lower():sub(1, #nameText) == nameText then
			return p
		end
	end
	return nil
end

local function applyFullOutfitBypass(targetPlayer)
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("Humanoid") then return end

	-- Clean old items safely
	for _, item in pairs(myChar:GetChildren()) do
		if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then
			item:Destroy()
		end
	end

	task.wait(0.1)

	-- 1. Try Avatar API Apply
	local success, desc = pcall(function()
		return Players:GetHumanoidDescriptionFromUserId(targetPlayer.UserId)
	end)

	if success and desc then
		pcall(function()
			myChar.Humanoid:ApplyDescription(desc)
		end)
	end

	-- 2. Forced Live Character Fallback (Guarantees Hairs & Clothes)
	task.delay(0.2, function()
		if targetPlayer.Character then
			for _, child in pairs(targetPlayer.Character:GetChildren()) do
				if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") or child:IsA("BodyColors") then
					if not myChar:FindFirstChildOfClass(child.ClassName) then
						child:Clone().Parent = myChar
					end
				elseif child:IsA("Accessory") then
					if not myChar:FindFirstChild(child.Name) then
						local acc = child:Clone()
						local handle = acc:FindFirstChild("Handle")
						if handle then
							handle.CanCollide = false
							handle.Massless = true
						end
						acc.Parent = myChar
						myChar.Humanoid:AddAccessory(acc)
					end
				end
			end
		end
	end)
end

CopyBtn.MouseButton1Click:Connect(function()
	local target = getTargetPlayer(TextBox.Text)
	if target then
		TextBox.Text = target.Name
		applyFullOutfitBypass(target)
	else
		TextBox.Text = "Player Not Found!"
	end
end)

ResetBtn.MouseButton1Click:Connect(function()
