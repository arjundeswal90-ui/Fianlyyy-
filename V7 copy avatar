local function getTargetPlayer(nameText)
	nameText = nameText:lower():gsub("%s+", "")
	for _, p in pairs(Players:GetPlayers()) do
		if p.Name:lower():sub(1, #nameText) == nameText or p.DisplayName:lower():sub(1, #nameText) == nameText then
			return p
		end
	end
	return nil
end

local function forceOutfitCopy(targetChar)
	local myChar = LocalPlayer.Character
	if not myChar or not targetChar then return end

	-- 1. Clear my character visuals
	for _, item in pairs(myChar:GetChildren()) do
		if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then
			item:Destroy()
		end
	end

	task.wait(0.1)

	-- 2. Force Copy Shirts & Pants Direct Textures
	local targetShirt = targetChar:FindFirstChildOfClass("Shirt")
	if targetShirt then
		local newShirt = Instance.new("Shirt")
		newShirt.ShirtTemplate = targetShirt.ShirtTemplate
		newShirt.Parent = myChar
	end

	local targetPants = targetChar:FindFirstChildOfClass("Pants")
	if targetPants then
		local newPants = Instance.new("Pants")
		newPants.PantsTemplate = targetPants.PantsTemplate
		newPants.Parent = myChar
	end

	local targetGraphic = targetChar:FindFirstChildOfClass("ShirtGraphic")
	if targetGraphic then
		local newGraphic = Instance.new("ShirtGraphic")
		newGraphic.Graphic = targetGraphic.Graphic
		newGraphic.Parent = myChar
	end

	local targetColors = targetChar:FindFirstChildOfClass("BodyColors")
	if targetColors then
		targetColors:Clone().Parent = myChar
	end

	-- 3. Force Clone All Accessories & Hairs
	for _, item in pairs(targetChar:GetChildren()) do
		if item:IsA("Accessory") then
			local accClone = item:Clone()
			local handle = accClone:FindFirstChild("Handle")
			
			if handle then
				handle.CanCollide = false
				handle.Massless = true
			end
			
			accClone.Parent = myChar
			if myChar:FindFirstChild("Humanoid") then
				myChar.Humanoid:AddAccessory(accClone)
			end
		end
	end
end

CopyBtn.MouseButton1Click:Connect(function()
	local target = getTargetPlayer(TextBox.Text)
	if target and target.Character then
		TextBox.Text = target.Name
		forceOutfitCopy(target.Character)
	else
		TextBox.Text = "Player Not Found!"
	end
end)

ResetBtn.MouseButton1Click:Connect(function()
	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
		pcall(function()
			local desc = Players:GetHumanoidDescriptionFromUserId(LocalPlayer.UserId)
			LocalPlayer.Character.Humanoid:ApplyDescription(desc)
		end)
	end
end)
