local function getTargetPlayer(nameText)
	nameText = nameText:lower():gsub("%s+", "")
	for _, p in pairs(Players:GetPlayers()) do
		if p.Name:lower():sub(1, #nameText) == nameText or p.DisplayName:lower():sub(1, #nameText) == nameText then
			return p
		end
	end
	return nil
end

local function applyGlitchFreeClone(targetChar)
	local myChar = LocalPlayer.Character
	if not myChar or not targetChar or not myChar:FindFirstChild("Humanoid") then return end

	-- Enable Archivable
	targetChar.Archivable = true
	for _, child in pairs(targetChar:GetDescendants()) do
		pcall(function() child.Archivable = true end)
	end

	-- Clear old layers
	for _, item in pairs(myChar:GetChildren()) do
		if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") or item:IsA("Folder") then
			item:Destroy()
		end
	end

	task.wait(0.1)

	-- Match Part Transparency & Mesh Properties to stop Texture Overlap
	for _, targetPart in pairs(targetChar:GetChildren()) do
		if targetPart:IsA("BasePart") then
			local myPart = myChar:FindFirstChild(targetPart.Name)
			if myPart and myPart:IsA("BasePart") then
				myPart.Transparency = targetPart.Transparency
				myPart.Color = targetPart.Color
				myPart.Material = targetPart.Material
			end
		end
	end

	-- Copy 2D Clothes & Body Colors
	for _, v in pairs(targetChar:GetChildren()) do
		if v:IsA("BodyColors") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") then
			v:Clone().Parent = myChar
		end
	end

	-- Copy Accessories with Mesh Smoothing
	for _, v in pairs(targetChar:GetChildren()) do
		if v:IsA("Accessory") then
			local acc = v:Clone()
			local handle = acc:FindFirstChild("Handle")
			if handle then
				handle.CanCollide = false
				handle.Massless = true
				for _, child in pairs(handle:GetChildren()) do
					if child:IsA("Weld") or child:IsA("ManualWeld") then
						child:Destroy()
					end
				end
			end
			acc.Parent = myChar
			myChar.Humanoid:AddAccessory(acc)
		end
	end

	-- Copy Custom Folders (Outerwear & Layered Assets)
	for _, folder in pairs(targetChar:GetChildren()) do
		if folder:IsA("Folder") then
			local folderClone = folder:Clone()
			folderClone.Parent = myChar
		end
	end

	myChar.Humanoid:BuildRigFromAttachments()
end

CopyBtn.MouseButton1Click:Connect(function()
	local target = getTargetPlayer(TextBox.Text)
	if target and target.Character then
		TextBox.Text = target.Name
		applyGlitchFreeClone(target.Character)
	else
		TextBox.Text = "Player Not Found!"
	end
end)

