local function getTargetPlayer(nameText)
	nameText = nameText:lower():gsub("%s+", "")
	for _, p in pairs(Players:GetPlayers()) do
		if p.Name:lower():sub(1, #nameText) == nameText or p.DisplayName:lower():sub(1, #nameText) == nameText then
			return p
		end
	end
	return nil
end

local function cloneClothingDirect(targetChar)
	local myChar = LocalPlayer.Character
	if not myChar or not targetChar then return end

	-- Clean visuals
	for _, item in pairs(myChar:GetChildren()) do
		if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") or item:IsA("Folder") then
			item:Destroy()
		end
	end

	task.wait(0.1)

	-- Direct 2D Clothing Copy with Archivable Unlock
	for _, child in pairs(targetChar:GetChildren()) do
		if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") or child:IsA("BodyColors") then
			child.Archivable = true
			local cloned = child:Clone()
			cloned.Parent = myChar
		end
	end

	-- Force Layered Clothing & 3D Accessories
	for _, child in pairs(targetChar:GetChildren()) do
		if child:IsA("Accessory") or child:IsA("Folder") then
			child.Archivable = true
			local clonedAcc = child:Clone()
			
			for _, part in pairs(clonedAcc:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
					part.Massless = true
				end
			end

			clonedAcc.Parent = myChar
			if myChar:FindFirstChild("Humanoid") and clonedAcc:IsA("Accessory") then
				myChar.Humanoid:AddAccessory(clonedAcc)
			end
		end
	end
end

CopyBtn.MouseButton1Click:Connect(function()
	local target = getTargetPlayer(TextBox.Text)
	if target and target.Character then
		TextBox.Text = target.Name
		cloneClothingDirect(target.Character)
	else
		TextBox.Text = "Player Not Found!"
	end
end)

ResetBtn.MouseButton1Click:Connect(function()
	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
		pcall(function()
			local desc = Players:GetHumanoidDescriptionFromUserId(LocalPlayer.UserId)
			LocalPlayer.Character.Humanoid:ApplyDescription(desc)
		end)
	end
end)
