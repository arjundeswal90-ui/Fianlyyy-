local function getTargetPlayer(nameText)
	nameText = nameText:lower():gsub("%s+", "")
	for _, p in pairs(Players:GetPlayers()) do
		if p.Name:lower():sub(1, #nameText) == nameText or p.DisplayName:lower():sub(1, #nameText) == nameText then
			return p
		end
	end
	return nil
end

local function copyFullRigAndBody(targetChar)
	local myChar = LocalPlayer.Character
	if not myChar or not targetChar then return end

	-- 1. Clear Current Visuals & Mesh Scaling
	for _, item in pairs(myChar:GetChildren()) do
		if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
			item:Destroy()
		end
	end

	task.wait(0.1)

	-- 2. Copy Body Meshes (Head, Torso, Arms, Legs MeshParts)
	for _, child in pairs(targetChar:GetChildren()) do
		if child:IsA("CharacterMesh") or child:IsA("BodyColors") then
			child.Archivable = true
			child:Clone().Parent = myChar
		end
	end

	-- 3. Copy MeshPart Textures & Scaling values
	for _, child in pairs(targetChar:GetChildren()) do
		if child:IsA("MeshPart") or child:IsA("BasePart") then
			local myPart = myChar:FindFirstChild(child.Name)
			if myPart and myPart:IsA("MeshPart") then
				myPart.MeshId = child.MeshId
				myPart.TextureID = child.TextureID
				myPart.Size = child.Size
			end
		end
	end

	-- 4. Copy Head Face / Decals
	if targetChar:FindFirstChild("Head") and myChar:FindFirstChild("Head") then
		for _, v in pairs(targetChar.Head:GetChildren()) do
			if v:IsA("Decal") or v:IsA("SpecialMesh") then
				v.Archivable = true
				if myChar.Head:FindFirstChildOfClass(v.ClassName) then
					myChar.Head:FindFirstChildOfClass(v.ClassName):Destroy()
				end
				v:Clone().Parent = myChar.Head
			end
		end
	end

	-- 5. Copy 2D Clothes
	for _, child in pairs(targetChar:GetChildren()) do
		if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") then
			child.Archivable = true
			child:Clone().Parent = myChar
		end
	end

	-- 6. Copy All 3D Layered Accessories
	for _, child in pairs(targetChar:GetChildren()) do
		if child:IsA("Accessory") then
			child.Archivable = true
			local accClone = child:Clone()
			
			for _, part in pairs(accClone:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
					part.Massless = true
				end
			end

			accClone.Parent = myChar
			if myChar:FindFirstChild("Humanoid") then
				myChar.Humanoid:AddAccessory(accClone)
			end
		end
	end

	-- 7. Copy Animation Script
	if targetChar:FindFirstChild("Animate") and myChar:FindFirstChild("Animate") then
		targetChar.Animate.Archivable = true
		myChar.Animate:Destroy()
		targetChar.Animate:Clone().Parent = myChar
	end
end

CopyBtn.MouseButton1Click:Connect(function()
	local target = getTargetPlayer(TextBox.Text)
	if target and target.Character then
		TextBox.Text = target.Name
		copyFullRigAndBody(target.Character)
	else
		TextBox.Text = "Player Not Found!"
	end
end)

ResetBtn.MouseButton1Click:Connect(function()
	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
		pcall(function()
			local desc = Players:GetHumanoidDescriptionFromUserId(LocalPlayer.UserId)
			LocalPlayer.Character.Humanoid:ApplyDescription(desc)
		end)
	end
end)
